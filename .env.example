# ============ LLM（生成标题/五点的模型）============
# DeepSeek（当前用的）：https://platform.deepseek.com
LLM_API_KEY=sk-your-deepseek-key-here
# 可选：换 OpenAI / 其他 OpenAI 兼容接口时改这两个
LLM_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# ============ 西柚 MCP（ASIN 反查关键词，不用可以留空）============
# 没开也能跑，只是竞品搜索会跳过西柚反查
XIYOU_MCP_TOKEN=

# ============ 可选：强制不调用西柚（默认 False，改成 True 可跳过）============
NO_XIYOU=false
